{
  "permissions": {
    "deny": [
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git clean *)",
      "Bash(git reset --hard *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ],
    "allow": [
      "Bash(docker compose *)",
      "Bash(docker exec *)",
      "Bash(docker ps *)",
      "Bash(docker logs *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git stash *)",
      "Bash(git fetch *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(codegraph *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(rm -f nul *)",
      "Bash(rm -f NUL *)",
      "Read",
      "Edit",
      "Write"
    ]
  },
  "claudeMdExcludes": [
    "**/.claude/rules/business-standards.md",
    "**/.claude/rules/mobile.md",
    "**/.claude/rules/i18n.md",
    "**/.claude/rules/infrastructure.md",
    "**/.claude/rules/api-conventions.md",
    "**/.claude/rules/performance.md",
    "**/.claude/rules/human-voice.md",
    "**/.claude/rules/documentation.md",
    "**/.claude/rules/architecture.md",
    "**/.claude/rules/testing.md",
    "**/.claude/rules/security.md",
    "**/.claude/rules/coding-style.md"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/tools/hooks/session_start.py\"",
            "timeout": 60,
            "statusMessage": "Session start: pipeline state, codegraph sync, memory health..."
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/tools/pipeline/supervisor.py\" --ensure-running",
            "timeout": 20,
            "statusMessage": "Starting the pipeline supervisor if it is not already running..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/tools/pipeline/pretool_gate.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/tools/pipeline/stop_gate.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "architect|product-manager|sprint-prioritizer|rapid-prototyper",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/tools/memory/inject.py\" --kinds module,pattern,lesson --limit 8",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "spec-developer",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/tools/memory/inject.py\" --kinds module,lesson --limit 8",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "senior-backend-dev|senior-frontend-dev|data-engineer|devops-engineer|qa-engineer|reviewer|security-engineer",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/tools/memory/inject.py\" --kinds lesson,pattern --limit 6",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/tools/hooks/inject_rules.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/tools/hooks/subagent_stop.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/tools/pipeline/state.py\" --resume",
            "timeout": 10,
            "statusMessage": "Preserving pipeline state through compaction..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rm -f nul NUL",
            "timeout": 5,
            "statusMessage": "Cleaning up NUL files..."
          }
        ]
      }
    ]
  },
  "autoMemoryEnabled": false
}
