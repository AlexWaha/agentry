          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rm -f nul NUL",
            "timeout": 5,
            "statusMessage": "Cleaning up NUL files..."
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/tools/hooks/refusal_notice.py\"",
            "timeout": 10
