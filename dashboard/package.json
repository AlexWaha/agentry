{
  "name": "agentry-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Harness X-ray dashboard SPA (dev-time sources; the built output is committed to plugin/tools/dashboard/dist)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "node ./node_modules/typescript-native/bin/tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "node ./node_modules/typescript-native/bin/tsc -b && vite build && python ../plugin/tools/dashboard/dist_manifest.py --write"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-router": "^1.170.45",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.71.2",
    "typescript-native": "npm:typescript@7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
